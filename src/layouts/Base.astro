---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { title, description = 'Data investigations and small interactive tools.' } = Astro.props;
const pageTitle = title ? `${title} | Wilson Rowe` : 'Wilson Rowe';
const path = Astro.url.pathname;
const nav = [
	{ href: '/', label: 'Home' },
	{ href: '/projects/', label: 'Projects' },
	{ href: '/about/', label: 'About' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{pageTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<a class="site-name" href="/">Wilson Rowe</a>
			<nav aria-label="Main">
				{
					nav.map((item) => (
						<a
							href={item.href}
							aria-current={
								item.href === '/' ? (path === '/' ? 'page' : undefined) : path.startsWith(item.href) ? 'page' : undefined
							}
						>
							{item.label}
						</a>
					))
				}
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<a href="https://github.com/wfrowe">GitHub</a>
		</footer>
	</body>
</html>
